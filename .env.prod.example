# =========================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION FOR RAPID7 INVENTORY MANAGER
# Rename this file to .env before starting the production docker compose stack.
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL.
# =========================================================================

# ─── DATABASE CONFIGURATION ──────────────────────────────────────────────
DB_USER=ioc_prod
DB_NAME=iocdb_prod
# CHANGE THIS: Use a strong, randomly generated alphanumeric password.
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE

# ─── BACKEND CONFIGURATION ───────────────────────────────────────────────
# CHANGE THIS: Generate a long, secure random key (e.g. openssl rand -base64 64)
JWT_SECRET=YOUR_SECURE_JWT_SECRET_HERE
JWT_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# Key used for backend dashboard/blue team admin panel actions.
# CHANGE THIS: Define a secure administrator token.
ADMIN_API_KEY=YOUR_SECURE_ADMIN_API_KEY_HERE

# Name shown in Authenticator Apps when setting up MFA
MFA_APP_NAME="CWO Inventory Manager"

# ─── SSO PORTAL CWO CONFIGURATION (KEYCLOAK) ─────────────────────────────
# Keycloak parameters. Ensure these match your production Keycloak setup.
VITE_KC_URL=https://sso.cwo.com.pt
VITE_KC_REALM=cwo
VITE_KC_CLIENT_ID=inventory-manager

# Keycloak domain used for Connect-Src in Content Security Policy (CSP) header
KC_ORIGIN=https://sso.cwo.com.pt

# ─── NETWORKING & SSL CERTIFICATES ───────────────────────────────────────
# Ports to map on the host system (usually 80 and 443 in production)
HTTP_PORT=80
HTTPS_PORT=443

# Directory on the host containing SSL certificate files.
# Must contain 'fullchain.pem' and 'privkey.pem'
SSL_CERTS_DIR=/etc/ssl/inventory
